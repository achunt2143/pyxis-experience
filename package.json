{
  "name": "bloom",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/app-sdk",
    "packages/apps/*"
  ],
  "scripts": {
    "dev": "vite",
    "dev:apps": "npm run dev --workspaces --if-present",
    "dev:all": "concurrently -n bloom,terminal,browser,files,notes,contacts,tasks,settings,installer -c auto \"npm:dev\" \"npm:dev -w packages/apps/terminal\" \"npm:dev -w packages/apps/browser\" \"npm:dev -w packages/apps/files\" \"npm:dev -w packages/apps/notes\" \"npm:dev -w packages/apps/contacts\" \"npm:dev -w packages/apps/tasks\" \"npm:dev -w packages/apps/settings\" \"npm:dev -w packages/apps/installer\"",
    "views": "duyo-views src",
    "build": "duyo-views src --check && tsc -b && vite build",
    "build:all": "npm run build --workspaces --if-present && npm run build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@duyojs/duyo": "^1.1.0",
    "@pyxis/app-sdk": "*",
    "framer-motion": "^12.25.0",
    "lucide-react": "^0.562.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remochi": "^0.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "concurrently": "^9.1.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^30.1.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^5.0.1"
  }
}
