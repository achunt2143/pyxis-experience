{
  "name": "bloom",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/app-sdk",
    "packages/apps/*"
  ],
  "scripts": {
    "dev": "vite",
    "dev:apps": "npm run dev --workspaces --if-present",
    "dev:all": "concurrently -n bloom,terminal,browser,files,notes,contacts,tasks,settings -c auto \"npm:dev\" \"npm:dev -w packages/apps/terminal\" \"npm:dev -w packages/apps/browser\" \"npm:dev -w packages/apps/files\" \"npm:dev -w packages/apps/notes\" \"npm:dev -w packages/apps/contacts\" \"npm:dev -w packages/apps/tasks\" \"npm:dev -w packages/apps/settings\"",
    "build": "tsc -b && vite build",
    "build:all": "npm run build --workspaces --if-present && npm run build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/material": "^5.14.0",
    "@pyxis/app-sdk": "*",
    "framer-motion": "^12.25.0",
    "lucide-react": "^0.562.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remochi": "^0.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.1.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}
