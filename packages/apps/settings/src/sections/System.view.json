{
  "name": "Settings.System",
  "kind": "pyxis.Control",
  "published": { "status": "" },
  "events": { "onRequest": "" },
  "components": [
    { "kind": "Settings.Groupbox", "title": "Power & session", "glyph": "Power", "glyphColor": "#ef4444", "components": [
      { "kind": "pyxis.Control", "content": "Manage the operating system power state and user session.", "style": "font-size:0.78rem;color:var(--color-text-secondary, #64748b);margin-bottom:4px" },
      { "kind": "pyxis.Control", "style": "display:grid;grid-template-columns:repeat(3, 1fr);gap:10px", "components": [
        { "kind": "pyxis.Control", "tag": "button", "classes": "st-power-button", "ontap": "askSleep", "components": [
          { "kind": "pyxis.Icon", "icon": "Moon", "size": 18, "color": "#8b5cf6" },
          { "kind": "pyxis.Control", "tag": "span", "content": "Sleep", "style": "font-size:0.78rem;font-weight:600" }
        ] },
        { "kind": "pyxis.Control", "tag": "button", "classes": "st-power-button", "ontap": "askReboot", "components": [
          { "kind": "pyxis.Icon", "icon": "RotateCcw", "size": 18, "color": "#3b82f6" },
          { "kind": "pyxis.Control", "tag": "span", "content": "Restart", "style": "font-size:0.78rem;font-weight:600" }
        ] },
        { "kind": "pyxis.Control", "tag": "button", "classes": "st-power-button danger", "ontap": "askShutdown", "components": [
          { "kind": "pyxis.Icon", "icon": "Power", "size": 18, "color": "#ef4444" },
          { "kind": "pyxis.Control", "tag": "span", "content": "Shut Down", "style": "font-size:0.78rem;font-weight:700;color:#ef4444" }
        ] }
      ] },
      { "name": "statusBox", "kind": "pyxis.Control", "showing": false, "style": "margin-top:6px", "components": [
        { "name": "badge", "kind": "remochi.Badge", "background": "var(--mochi-primary, #2f6fed)", "color": "#fff" }
      ] }
    ] }
  ]
}
