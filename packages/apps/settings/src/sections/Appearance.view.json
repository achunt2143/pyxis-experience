        { "name": "themeAuto", "kind": "Settings.Choice", "option": "auto", "label": "Auto", "hint": "Dark from dusk to dawn", "glyph": "SunMoon", "glyphColor": "#0ea5e9", "attributes": { "data-theme-choice": "auto" }, "ontap": "pickTheme" }
