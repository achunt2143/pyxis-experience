{
  "name": "Settings.Location",
  "kind": "pyxis.Control",
  "published": { "clock": null, "location": null, "stored": null, "hour24": false, "editing": false, "saveError": "" },
  "components": [
    { "kind": "Settings.Groupbox", "title": "Location", "glyph": "MapPin", "glyphColor": "#f43f5e", "group": "location", "components": [
      { "kind": "pyxis.Control", "classes": "st-secondary", "content": "Where the sun is for the Daylight wallpaper and the Auto theme. Nothing leaves the device." },
      { "name": "source", "kind": "Settings.Fact", "label": "Location" },
      { "name": "coords", "kind": "Settings.Fact", "label": "Coordinates" },
      { "name": "sun", "kind": "Settings.Fact", "label": "Today", "glyph": "Sunrise", "attributes": { "data-location-sun": true } },
      { "name": "actions", "kind": "pyxis.Control", "style": "display:flex;gap:8px;flex-wrap:wrap", "components": [
        { "name": "editWrap", "kind": "pyxis.Control", "tag": "span", "components": [
          { "name": "editButton", "kind": "remochi.Button", "ontap": "startEditing" }
        ] },
        { "name": "useZone", "kind": "pyxis.Control", "tag": "span", "components": [
          { "kind": "remochi.Button", "content": "Use the time zone's location", "ontap": "revertToZone" }
        ] }
      ] },
      { "name": "form", "kind": "pyxis.Control", "classes": "st-mochi-card", "showing": false, "components": [
        { "name": "fLabel", "kind": "Settings.Field", "label": "Name", "placeholder": "e.g. Home (optional)", "field": "label", "onEnter": "save" },
        { "kind": "pyxis.Control", "style": "display:grid;grid-template-columns:repeat(auto-fit, minmax(min(160px, 100%), 1fr));gap:10px;width:100%;min-width:0", "components": [
          { "name": "fLat", "kind": "Settings.Field", "label": "Latitude", "placeholder": "e.g. 34.05 or 34.05 N", "field": "lat", "onEnter": "save" },
          { "name": "fLon", "kind": "Settings.Field", "label": "Longitude", "placeholder": "e.g. -118.24 or 118.24 W", "field": "lon", "onEnter": "save" }
        ] },
        { "kind": "pyxis.Control", "style": "display:flex;gap:8px;justify-content:flex-end;flex-wrap:wrap", "components": [
          { "kind": "pyxis.Control", "tag": "span", "attributes": { "data-location-cancel": true }, "components": [
            { "kind": "remochi.Button", "content": "Cancel", "ontap": "cancelEditing" }
          ] },
          { "kind": "pyxis.Control", "tag": "span", "attributes": { "data-location-save": true }, "components": [
            { "kind": "remochi.Button", "content": "Save location", "ontap": "save" }
          ] }
        ] }
      ] },
      { "name": "error", "kind": "pyxis.Control", "classes": "st-error", "showing": false }
    ] }
  ]
}
