{
  "name": "Settings.App",
  "kind": "pyxis.Control",
  "classes": "st-app",
  "published": { "windowId": "", "section": "appearance", "pendingPower": "", "powerStatus": "" },
  "events": { "onClose": "" },
  "components": [
    { "kind": "pyxis.Control", "style": "flex:1;min-height:0;position:relative", "components": [
      { "name": "stack", "kind": "remochi.RepanelStack", "activeIndex": 1, "peek": 260, "components": [
        { "kind": "remochi.Repanel", "components": [
          { "kind": "pyxis.Control", "style": "position:absolute;inset:0;display:flex;flex-direction:column;min-height:0", "components": [
            { "kind": "remochi.Header", "content": "Settings" },
            { "kind": "pyxis.Control", "attributes": { "data-settings-rail": true }, "style": "flex:1;overflow-y:auto;min-height:0;padding:4px 8px", "components": [
              { "kind": "remochi.List", "components": [
                { "kind": "remochi.ListHeader", "content": "PREFERENCES" },
                { "name": "rail", "kind": "pyxis.Repeater", "itemKind": "Settings.RailRow", "keyField": "id", "itemProps": { "ontap": "pickSection", "onkeydown": "railKey" } }
              ] }
            ] },
            { "name": "footer", "kind": "pyxis.Control", "style": "padding:12px 16px;border-top:1px solid var(--color-border, var(--mochi-border, #e5e7eb));font-size:0.72rem;color:var(--color-text-secondary, #64748b);background:var(--mochi-hover, rgba(0,0,0,0.02))" }
          ] }
        ] },
        { "kind": "remochi.Repanel", "components": [
          { "name": "stage", "kind": "pyxis.Control", "style": "position:absolute;inset:0;overflow-y:auto;padding:20px 28px;display:flex;flex-direction:column;gap:16px;min-width:0", "components": [
            { "kind": "pyxis.Control", "style": "display:flex;align-items:center;gap:10px;margin-bottom:2px", "components": [
              { "name": "stageBadge", "kind": "pyxis.Control", "style": "width:32px;height:32px;border-radius:13px 3px 13px 13px;display:flex;align-items:center;justify-content:center", "components": [
                { "name": "stageIcon", "kind": "pyxis.Icon", "size": 18 }
              ] },
              { "name": "stageTitle", "kind": "pyxis.Control", "tag": "h1", "style": "font-size:1.25rem;font-weight:700;margin:0" }
            ] },
            { "name": "host", "kind": "pyxis.Control" }
          ] }
        ] }
      ] }
    ] },
    { "name": "powerDialog", "kind": "remochi.Dialog", "dialogType": "confirm", "cancelText": "Cancel", "onConfirm": "powerConfirmed", "onCancel": "powerCancelled", "components": [
      { "name": "powerText", "kind": "pyxis.Control", "tag": "p", "style": "margin:0;color:var(--color-text);font-size:0.9rem;line-height:1.5" }
    ] }
  ]
}
