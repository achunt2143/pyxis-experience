{
  "name": "Settings.App",
  "kind": "pyxis.Control",
  "classes": "st-app",
  "published": { "windowId": "", "section": "appearance", "pendingPower": "", "powerStatus": "" },
  "events": { "onClose": "" },
  "components": [
    { "kind": "pyxis.Control", "style": "flex:1;min-height:0;position:relative", "components": [
      { "name": "stack", "kind": "remochi.RepanelStack", "activeIndex": 1, "peek": 260, "components": [
        { "kind": "remochi.Repanel", "components": [
          { "kind": "pyxis.Control", "style": "position:absolute;inset:0;display:flex;flex-direction:column;min-height:0;min-width:0", "components": [
            { "kind": "remochi.Header", "content": "Settings" },
            { "kind": "pyxis.Control", "style": "padding:0 32px", "components": [
              { "kind": "remochi.Divider" }
            ] },
            { "kind": "pyxis.Control", "attributes": { "data-settings-rail": true }, "style": "flex:1;overflow-y:auto;overflow-x:hidden;min-height:0;min-width:0;padding:4px 8px", "components": [
              { "kind": "remochi.List", "components": [
                { "kind": "remochi.ListHeader", "content": "PREFERENCES" },
                { "name": "rail", "kind": "pyxis.Repeater", "itemKind": "Settings.RailRow", "keyField": "id", "itemProps": { "ontap": "pickSection", "onkeydown": "railKey" } }
              ] }
            ] },
            { "name": "footer", "kind": "pyxis.Control", "style": "padding:12px 16px;border-top:1px solid var(--mochi-border);font-size:0.72rem;color:var(--mochi-text-muted);background:var(--mochi-hover)" }
          ] }
        ] },
        { "kind": "remochi.Repanel", "components": [
          { "name": "stage", "kind": "pyxis.Control", "style": "position:absolute;inset:0;display:flex;flex-direction:column;min-height:0;min-width:0", "components": [
            { "name": "stageHeader", "kind": "remochi.Header", "components": [
              { "name": "backButton", "kind": "remochi.Button", "content": "← Sections", "classes": "st-back-btn", "attributes": { "data-settings-back": true }, "ontap": "backToRail" }
            ] },
            { "kind": "pyxis.Control", "style": "padding:0 32px", "components": [
              { "kind": "remochi.Divider" }
            ] },
            { "name": "stageTitle", "kind": "pyxis.Control", "tag": "h1", "classes": "st-sr-only" },
            { "kind": "pyxis.Control", "style": "flex:1;overflow-y:auto;overflow-x:hidden;min-height:0;min-width:0;padding:16px 32px 28px;display:flex;flex-direction:column;gap:20px", "components": [
              { "name": "host", "kind": "pyxis.Control", "style": "min-width:0;width:100%;max-width:100%;box-sizing:border-box" }
            ] }
          ] }
        ] }
      ] }
    ] },
    { "name": "powerDialog", "kind": "remochi.Dialog", "dialogType": "confirm", "tone": "warning", "confirmType": "warning", "cancelText": "Cancel", "onConfirm": "powerConfirmed", "onCancel": "powerCancelled", "onDismiss": "powerCancelled", "components": [
      { "name": "powerText", "kind": "pyxis.Control", "tag": "p", "style": "margin:0;color:var(--mochi-text);font-size:0.9rem;line-height:1.5" }
    ] }
  ]
}
