{
  "name": "Contacts.App",
  "kind": "pyxis.Control",
  "style": "width:100%;height:100%;display:flex;flex-direction:column;background:var(--color-background, var(--mochi-bg, #f5f5f5));color:var(--color-text, var(--mochi-text, #111827));overflow:hidden;user-select:none;min-height:0",
  "published": { "windowId": "", "contacts": [], "selectedId": null, "search": "", "category": "All", "loaded": false, "saveStatus": "saved" },
  "events": { "onClose": "" },
  "components": [
    { "kind": "pyxis.Control", "style": "flex:1;min-height:0;position:relative", "components": [
      { "name": "stack", "kind": "remochi.RepanelStack", "activeIndex": 0, "peek": 280, "components": [
        { "kind": "remochi.Repanel", "components": [
          { "name": "list", "kind": "Contacts.List", "onAddContact": "addContact", "onExportAll": "exportAll", "onSearchChange": "searchEdited", "onCategoryChange": "categoryPicked", "onSelectContact": "selectContact" }
        ] },
        { "kind": "remochi.Repanel", "components": [
          { "name": "detail", "kind": "Contacts.Detail", "onAddContact": "addContact", "onEdit": "editContact", "onAskDelete": "askDelete" }
        ] }
      ] }
    ] },
    { "name": "deleteDialog", "kind": "remochi.Dialog", "title": "Delete Contact", "dialogType": "confirm", "confirmText": "Delete", "cancelText": "Cancel", "onConfirm": "deleteConfirmed", "onClose": "dialogDismissed", "components": [
      { "kind": "pyxis.Control", "tag": "p", "style": "margin:0;color:var(--color-text);font-size:0.9rem;line-height:1.5", "components": [
        { "kind": "pyxis.Control", "tag": "span", "content": "Delete " },
        { "name": "deleteName", "kind": "pyxis.Control", "tag": "strong", "content": "this contact" },
        { "kind": "pyxis.Control", "tag": "span", "content": " from your address book? This cannot be undone." }
      ] }
    ] }
  ]
}
