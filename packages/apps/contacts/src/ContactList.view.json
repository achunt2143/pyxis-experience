{
  "name": "Contacts.List",
  "kind": "pyxis.Control",
  "style": "position:absolute;inset:0;display:flex;flex-direction:column;min-width:0;min-height:0",
  "published": { "items": [], "counts": {}, "category": "All", "search": "", "selectedId": null, "loaded": false, "total": 0, "notice": "" },
  "events": { "onAddContact": "", "onExportAll": "", "onSearchChange": "", "onCategoryChange": "", "onSelectContact": "", "onImportFile": "" },
  "components": [
    { "kind": "remochi.Header", "content": "Contacts", "components": [
      { "kind": "pyxis.Control", "style": "display:flex;align-items:center;gap:6px", "components": [
        { "kind": "pyxis.Control", "tag": "span", "attributes": { "title": "New Contact" }, "components": [
          { "name": "newButton", "kind": "remochi.Button", "variant": "blue", "ontap": "add", "attributes": { "aria-label": "New Contact" }, "components": [
            { "kind": "pyxis.Icon", "icon": "Plus", "size": 14, "style": "vertical-align:middle;margin-right:4px" },
            { "kind": "pyxis.Control", "tag": "span", "content": "New" }
          ] }
        ] },
        { "kind": "pyxis.Control", "tag": "span", "attributes": { "title": "Import contacts (.vcf)" }, "components": [
          { "name": "importButton", "kind": "remochi.Button", "variant": "normal", "ontap": "importPick", "attributes": { "aria-label": "Import contacts" }, "components": [
            { "kind": "pyxis.Icon", "icon": "Upload", "size": 14, "style": "vertical-align:middle" }
          ] }
        ] },
        { "name": "exportWrap", "kind": "pyxis.Control", "tag": "span", "showing": false, "attributes": { "title": "Export all contacts (.vcf)" }, "components": [
          { "kind": "remochi.Button", "variant": "normal", "ontap": "exportAll", "attributes": { "aria-label": "Export all contacts" }, "components": [
            { "kind": "pyxis.Icon", "icon": "Download", "size": 14, "style": "vertical-align:middle" }
          ] }
        ] }
      ] }
    ] },
    { "kind": "pyxis.Control", "style": "padding:0 32px", "components": [
      { "kind": "remochi.Divider" }
    ] },
    { "kind": "pyxis.Control", "style": "padding:8px 16px;display:flex;align-items:center;gap:8px;background:var(--mochi-surface);border-bottom:1px solid var(--mochi-border);min-width:0", "components": [
      { "kind": "pyxis.Control", "style": "flex:1;min-width:0;position:relative", "components": [
        { "name": "search", "kind": "remochi.Input", "type": "search", "placeholder": "Search contacts…", "width": "100%", "classes": "contacts-search", "style": "display:block", "oninput": "searchInput" }
      ] }
    ] },
    { "name": "notice", "kind": "pyxis.Control", "showing": false, "attributes": { "role": "status" },
      "style": "padding:6px 16px;font-size:12px;color:var(--mochi-text-muted);background:var(--mochi-surface);border-bottom:1px solid var(--mochi-border)" },
    { "name": "pills", "kind": "pyxis.Repeater", "itemKind": "Contacts.Pill", "keyField": "id", "itemProps": { "ontap": "pickCategory" },
      "style": "display:flex;gap:6px;padding:8px 16px;border-bottom:1px solid var(--mochi-border);overflow-x:auto;scrollbar-width:none;background:var(--mochi-surface)" },
    { "kind": "pyxis.Control", "style": "flex:1;min-width:0;min-height:0;display:flex;flex-direction:column;position:relative", "components": [
      { "name": "loading", "kind": "pyxis.Control", "style": "display:flex;justify-content:center;padding:32px", "components": [
        { "kind": "remochi.Spinner", "styleType": "light", "size": "normal", "alt": "Loading contacts" }
      ] },
      { "name": "empty", "kind": "pyxis.Control", "showing": false, "style": "display:flex;flex-direction:column;align-items:center;justify-content:center;height:70%;gap:8px;color:var(--mochi-text-muted)", "components": [
        { "kind": "pyxis.Icon", "icon": "Users", "size": 40, "style": "opacity:0.3" },
        { "name": "emptyText", "kind": "pyxis.Control", "tag": "span", "style": "font-size:0.88rem;font-weight:500" }
      ] },
      { "name": "directory", "kind": "Contacts.Directory", "showing": false, "style": "flex:1;min-width:0;min-height:0", "onSelectContact": "directoryPicked" }
    ] }
  ]
}
