#!/bin/sh
# Generated by Vroom (pyxis package). Removes package-owned caches only;
# user data/profiles are never touched here (spec section 18.2).
set -e
rm -rf /var/cache/pyxis/notes 2>/dev/null || true
if command -v systemctl >/dev/null 2>&1; then
  systemctl daemon-reload || true
fi
if command -v pyxis-appctl >/dev/null 2>&1; then
  pyxis-appctl rescan || true
fi
exit 0
