{
  "name": "Notes.Editor",
  "kind": "pyxis.Control",
  "style": "position:absolute;inset:0;display:flex;flex-direction:column;min-width:0;min-height:0",
  "published": { "note": null, "loaded": false, "saveStatus": "saved", "copied": false, "copyError": "" },
  "events": { "onEdit": "", "onAskDelete": "", "onBack": "" },
  "components": [
    { "name": "header", "kind": "remochi.Header", "content": "Editor", "components": [
      { "name": "backButton", "kind": "remochi.Button", "content": "← Notes", "classes": "notes-back-btn", "ontap": "back", "attributes": { "aria-label": "Back to Notes" } },
      { "name": "headerActions", "kind": "pyxis.Control", "showing": false, "style": "display:flex;align-items:center;gap:6px", "components": [
        { "name": "pinWrap", "kind": "pyxis.Control", "tag": "span", "attributes": { "title": "Pin Note to Top" }, "components": [
          { "name": "pinButton", "kind": "remochi.Button", "ontap": "togglePin", "attributes": { "aria-label": "Pin Note to Top" }, "components": [
            { "name": "pinIcon", "kind": "pyxis.Icon", "icon": "Pin", "size": 15, "style": "vertical-align:middle" }
          ] }
        ] },
        { "kind": "pyxis.Control", "tag": "span", "attributes": { "title": "Copy Note Content" }, "components": [
          { "name": "copyButton", "kind": "remochi.Button", "ontap": "copy", "attributes": { "aria-label": "Copy Note Content" }, "components": [
            { "name": "copyIcon", "kind": "pyxis.Icon", "icon": "Copy", "size": 15, "style": "vertical-align:middle" }
          ] }
        ] },
        { "kind": "pyxis.Control", "tag": "span", "attributes": { "title": "Export Note as Markdown (.md)" }, "components": [
          { "name": "exportButton", "kind": "remochi.Button", "ontap": "exportIt", "attributes": { "aria-label": "Export Note as Markdown (.md)" }, "components": [
            { "kind": "pyxis.Icon", "icon": "Share2", "size": 15, "style": "vertical-align:middle" }
          ] }
        ] },
        { "name": "trashWrap", "kind": "pyxis.Control", "tag": "span", "attributes": { "title": "Delete Note" }, "components": [
          { "name": "deleteButton", "kind": "remochi.Button", "variant": "warning", "ontap": "askDelete", "attributes": { "aria-label": "Delete Note" }, "components": [
            { "kind": "pyxis.Icon", "icon": "Trash2", "size": 15, "style": "vertical-align:middle" }
          ] }
        ] }
      ] }
    ] },
    { "kind": "pyxis.Control", "style": "padding:0 32px", "components": [
      { "kind": "remochi.Divider" }
    ] },
    { "name": "copyErrorBar", "kind": "pyxis.Control", "showing": false,
      "style": "padding:6px 24px;font-size:12px;color:var(--mochi-error);background:color-mix(in srgb, var(--mochi-error) 12%, transparent);border-bottom:1px solid color-mix(in srgb, var(--mochi-error) 30%, transparent)"
    },
    { "name": "empty", "kind": "pyxis.Control", "style": "flex:1;min-width:0;overflow-y:auto;overflow-x:hidden;padding:24px;text-align:center;display:flex;flex-direction:column;align-items:center;justify-content:center;color:var(--mochi-text-muted);gap:8px", "components": [
      { "kind": "pyxis.Icon", "icon": "FileText", "size": 36, "strokeWidth": 1.5, "color": "var(--mochi-border)" },
      { "name": "emptyText", "kind": "pyxis.Control", "tag": "span", "style": "font-size:13px" }
    ] },
    { "name": "pane", "kind": "pyxis.Control", "showing": false, "style": "flex:1;display:flex;flex-direction:column;min-width:0;min-height:0", "components": [
      { "kind": "pyxis.Control", "style": "display:flex;gap:10px;align-items:center;padding:10px 24px;border-bottom:1px solid var(--mochi-border);background:var(--mochi-surface)", "components": [
        { "name": "title", "kind": "remochi.Input", "placeholder": "Note title", "width": "100%", "classes": "notes-title-input", "style": "display:block;flex:1;min-width:0", "attributes": { "aria-label": "note title" }, "oninput": "titleInput" },
        { "kind": "pyxis.Control", "style": "width:130px", "components": [
          { "name": "category", "kind": "remochi.Dropdown", "onChange": "categoryPicked", "options": [
            { "value": "General", "label": "General" },
            { "value": "Personal", "label": "Personal" },
            { "value": "Work", "label": "Work" },
            { "value": "Ideas", "label": "Ideas" }
          ] }
        ] }
      ] },
      { "kind": "pyxis.Control", "style": "flex:1;min-width:0;min-height:0;overflow-y:auto;overflow-x:hidden;padding:16px 24px;display:flex", "components": [
        { "name": "body", "kind": "remochi.TextArea", "placeholder": "Start writing thoughts, memos, or markdown notes…", "classes": "pyxis-notes-body", "minHeight": 200, "oninput": "bodyInput" }
      ] },
      { "kind": "pyxis.Control", "style": "padding:8px 24px;font-size:12px;color:var(--mochi-text-muted);border-top:1px solid var(--mochi-border);display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;background:var(--mochi-surface)", "components": [
        { "kind": "pyxis.Control", "components": [
          { "name": "saving", "kind": "pyxis.Control", "showing": false, "style": "display:flex;align-items:center;gap:6px", "components": [
            { "kind": "remochi.Spinner", "styleType": "light", "size": "normal" },
            { "kind": "pyxis.Control", "tag": "span", "content": "Saving…", "style": "font-size:12px;color:var(--mochi-text-muted)" }
          ] },
          { "name": "saved", "kind": "pyxis.Control", "style": "display:flex;align-items:center;gap:6px", "components": [
            { "kind": "pyxis.Icon", "icon": "CircleCheck", "size": 13, "color": "var(--mochi-success)" },
            { "kind": "pyxis.Control", "tag": "span", "content": "Saved to Pyxis PIM storage", "style": "font-size:12px;color:var(--mochi-text-muted)" }
          ] },
          { "name": "saveErrorFooter", "kind": "pyxis.Control", "showing": false, "style": "display:flex;align-items:center;gap:6px", "components": [
            { "kind": "pyxis.Control", "tag": "span", "content": "Save failed", "style": "font-size:12px;color:var(--mochi-error);font-weight:600" }
          ] }
        ] },
        { "kind": "pyxis.Control", "style": "display:flex;align-items:center;gap:14px", "components": [
          { "name": "edited", "kind": "pyxis.Control", "tag": "span" },
          { "kind": "pyxis.Control", "tag": "span", "style": "display:inline-flex;align-items:center;gap:4px", "components": [
            { "kind": "pyxis.Icon", "icon": "FileText", "size": 12, "style": "vertical-align:middle" },
            { "name": "stats", "kind": "pyxis.Control", "tag": "span" }
          ] }
        ] }
      ] }
    ] }
  ]
}
