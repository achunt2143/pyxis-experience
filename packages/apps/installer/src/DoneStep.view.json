{
  "name": "Installer.Done",
  "kind": "pyxis.Control",
  "published": { "info": {} },
  "events": { "onOpen": "", "onAgain": "" },
  "components": [
    { "name": "none", "kind": "pyxis.Control", "style": "color:var(--mochi-text-muted)", "content": "Nothing installed yet." },
    { "name": "content", "kind": "pyxis.Control", "style": "display:flex;flex-direction:column;gap:12px;min-width:0", "showing": false, "components": [
      { "kind": "pyxis.Control", "style": "display:flex;align-items:center;gap:14px;padding:16px;background:color-mix(in srgb, var(--mochi-success) 14%, transparent);border:1px solid color-mix(in srgb, var(--mochi-success) 35%, transparent);border-radius:var(--mochi-corner-sm, 10px);min-width:0;flex-wrap:wrap", "components": [
        { "kind": "pyxis.Icon", "icon": "CircleCheck", "size": 32, "color": "var(--mochi-success)", "style": "flex-shrink:0" },
        { "kind": "pyxis.Control", "style": "min-width:0;flex:1", "components": [
          { "name": "title", "kind": "pyxis.Control", "style": "font-size:18px;font-weight:700;color:var(--mochi-text);overflow-wrap:anywhere" },
          { "name": "detail", "kind": "pyxis.Control", "style": "font-size:13px;color:var(--mochi-text-muted);margin-top:2px;overflow-wrap:anywhere" }
        ] }
      ] },
      { "name": "notLaunchable", "kind": "pyxis.Control", "showing": false, "style": "display:flex;align-items:flex-start;gap:8px;font-size:13px;color:var(--mochi-text-muted);min-width:0", "components": [
        { "kind": "pyxis.Icon", "icon": "TriangleAlert", "size": 16, "color": "var(--mochi-warning)", "style": "flex-shrink:0" },
        { "kind": "pyxis.Control", "tag": "span", "style": "min-width:0", "content": "Installed, but the launcher has not registered it as a launchable app. It may be a service or library." }
      ] },
      { "kind": "pyxis.Control", "style": "display:flex;gap:10px;margin-top:8px;flex-wrap:wrap", "components": [
        { "name": "open", "kind": "remochi.Button", "variant": "affirmative", "ontap": "openTap", "showing": false, "components": [
          { "kind": "pyxis.Icon", "icon": "Play", "size": 14, "style": "vertical-align:middle;margin-right:6px" },
          { "name": "openLabel", "kind": "pyxis.Control", "tag": "span" }
        ] },
        { "name": "again", "kind": "remochi.Button", "variant": "normal", "ontap": "againTap", "content": "Install another package" }
      ] },
      { "name": "launchErrorRow", "kind": "pyxis.Control", "style": "display:flex;align-items:center;gap:8px;padding:10px 12px;border-radius:var(--mochi-corner-sm, 10px);background:color-mix(in srgb, var(--mochi-error) 12%, transparent);border:1px solid color-mix(in srgb, var(--mochi-error) 35%, transparent);color:var(--mochi-error);font-size:13px;min-width:0;overflow-wrap:anywhere", "showing": false, "components": [
        { "kind": "pyxis.Icon", "icon": "TriangleAlert", "size": 16, "style": "flex-shrink:0" },
        { "name": "launchErrorText", "kind": "pyxis.Control", "tag": "span", "style": "min-width:0" }
      ] },
      { "name": "logBox", "kind": "pyxis.Control", "style": "margin-top:12px;min-width:0", "showing": false, "components": [
        { "kind": "remochi.Collapsable", "title": "Installation log", "expanded": false, "components": [
          { "name": "log", "kind": "pyxis.Control", "tag": "pre", "style": "font-size:11px;line-height:1.45;white-space:pre-wrap;overflow-wrap:anywhere;max-width:100%;background:var(--mochi-surface);border:1px solid var(--mochi-border);color:var(--mochi-text);padding:10px;border-radius:var(--mochi-corner-sm, 10px);margin-top:8px;max-height:160px;overflow-y:auto" }
        ] }
      ] }
    ] }
  ]
}
