{
  "name": "Installer.App",
  "kind": "pyxis.Control",
  "style": "width:100%;height:100%;background:var(--mochi-bg);overflow:hidden;min-height:0",
  "published": { "windowId": "", "installer": null, "mode": "wizard", "selected": null, "launched": false, "launching": false, "launchError": "", "launchingPackage": null, "removing": null, "installedError": "" },
  "events": { "onClose": "" },
  "components": [
    { "kind": "remochi.Repanel", "components": [
      { "kind": "pyxis.Control", "style": "flex:1;height:100%;display:flex;flex-direction:column;min-height:0;min-width:0;width:100%;overflow:hidden", "components": [
        { "kind": "remochi.Header", "content": "App Installer", "style": "flex-shrink:0", "components": [
          { "name": "rescan", "kind": "remochi.Button", "variant": "normal", "showing": false, "ontap": "rescan", "components": [
            { "kind": "pyxis.Icon", "icon": "RefreshCw", "size": 13, "style": "vertical-align:middle;margin-right:4px" },
            { "kind": "pyxis.Control", "tag": "span", "content": "Rescan", "style": "font-size:11px" }
          ] }
        ] },
        { "kind": "remochi.Divider", "thickness": 2, "style": "flex-shrink:0" },
        { "kind": "pyxis.Control", "classes": "inst-toolbar", "style": "display:flex;align-items:center;gap:8px;padding:8px 32px;background:var(--mochi-surface);flex-shrink:0;flex-wrap:wrap;min-width:0", "components": [
          { "name": "tabWizard", "kind": "remochi.Button", "variant": "blue", "classes": "inst-tab active", "ontap": "tapWizard", "components": [
            { "kind": "pyxis.Control", "tag": "span", "style": "display:inline-flex;align-items:center;gap:6px", "components": [
              { "kind": "pyxis.Icon", "icon": "Package", "size": 13 },
              { "kind": "pyxis.Control", "tag": "span", "content": "Install Package (.ipk)" }
            ] }
          ] },
          { "name": "tabInstalled", "kind": "remochi.Button", "variant": "normal", "classes": "inst-tab", "ontap": "tapInstalled", "components": [
            { "kind": "pyxis.Control", "tag": "span", "style": "display:inline-flex;align-items:center;gap:6px", "components": [
              { "kind": "pyxis.Control", "tag": "span", "content": "Installed Applications" },
              { "name": "installedCount", "kind": "pyxis.Control", "tag": "span", "classes": "inst-tab-count", "content": "0" }
            ] }
          ] }
        ] },
        { "kind": "remochi.Divider", "thickness": 1, "style": "flex-shrink:0" },
        { "name": "wizardBody", "kind": "pyxis.Control", "classes": "inst-scroll-body", "style": "flex:1;min-height:0;min-width:0;overflow-y:auto;overflow-x:hidden;padding:16px 32px", "components": [
          { "name": "wizard", "kind": "remochi.Wizard", "showStepNumbers": true, "onComplete": "closeApp", "onCancel": "closeApp", "onStepChange": "wizardStepped", "components": [
            { "kind": "remochi.WizardStep", "label": "Choose", "title": "Choose a package", "description": "Select an .ipk package to install.", "onNext": "guardNext", "components": [
              { "name": "choose", "kind": "Installer.Choose", "onRescan": "rescan", "onPick": "pickPackage" }
            ] },
            { "kind": "remochi.WizardStep", "label": "Review", "title": "Review details", "description": "Check package specifications and requested permissions.", "onNext": "guardNext", "components": [
              { "name": "review", "kind": "Installer.Review" }
            ] },
            { "kind": "remochi.WizardStep", "label": "Install", "title": "Installing", "description": "Running opkg and registering with Pyxis desktop.", "onNext": "guardNext", "components": [
              { "name": "install", "kind": "Installer.Install", "onRetry": "retryInstall" }
            ] },
            { "kind": "remochi.WizardStep", "label": "Done", "title": "Installation complete", "components": [
              { "name": "done", "kind": "Installer.Done", "onOpen": "launchFromDone", "onAgain": "startOver" }
            ] }
          ] }
        ] },
        { "name": "installedBody", "kind": "pyxis.Control", "classes": "inst-scroll-body", "showing": false, "style": "flex:1;min-height:0;min-width:0;overflow-y:auto;overflow-x:hidden;padding:16px 32px", "components": [
          { "name": "installedPane", "kind": "Installer.Installed", "onLaunch": "launchInstalled", "onRemove": "removePackage" }
        ] }
      ] }
    ] }
  ]
}
