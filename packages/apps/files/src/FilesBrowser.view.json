{
  "name": "Files.Browser",
  "kind": "pyxis.Control",
  "style": "position:absolute;inset:0;display:flex;flex-direction:column;min-height:0",
  "published": {
    "folder": "~", "canBack": false, "viewMode": "list", "sortBy": "name", "sortOrder": "asc",
    "query": "", "busy": false, "dir": null, "entries": [], "selectedPath": null
  },
  "events": {
    "onGoBack": "", "onGoUp": "", "onNavigate": "", "onSearch": "", "onViewMode": "", "onCycleSort": "",
    "onNewFolder": "", "onReload": "", "onOpenEntry": "", "onEntryMenu": ""
  },
  "components": [
    { "kind": "pyxis.Control", "style": "padding:10px 14px;display:flex;align-items:center;gap:10px;background:var(--color-surface, var(--mochi-surface, #ffffff));border-bottom:1px solid var(--color-border, var(--mochi-border, #e5e7eb));flex-wrap:wrap", "components": [
      { "kind": "pyxis.Control", "style": "display:flex;gap:4px;align-items:center", "components": [
        { "name": "back", "kind": "remochi.Button", "ontap": "goBack", "disabled": true, "components": [
          { "kind": "pyxis.Icon", "icon": "ChevronLeft", "size": 16 }
        ] },
        { "name": "up", "kind": "remochi.Button", "ontap": "goUp", "components": [
          { "kind": "pyxis.Icon", "icon": "ChevronUp", "size": 16 }
        ] }
      ] },
      { "name": "crumbs", "kind": "pyxis.Repeater", "itemKind": "Files.Crumb", "keyField": "path", "itemProps": { "ontap": "pickCrumb" },
        "style": "display:flex;align-items:center;gap:4px;flex:1 1 200px;min-width:0;overflow-x:auto;scrollbar-width:none;padding:2px 0" },
      { "kind": "pyxis.Control", "style": "width:160px;min-width:120px", "components": [
        { "name": "search", "kind": "remochi.Input", "type": "search", "placeholder": "Search…", "width": "100%", "classes": "files-search", "style": "display:block", "oninput": "searchInput" }
      ] },
      { "name": "views", "kind": "remochi.ViewSelectButton", "items": [ { "content": "☰" }, { "content": "⊞" } ], "selected": 0, "onSelect": "pickView" },
      { "name": "sortWrap", "kind": "pyxis.Control", "tag": "span", "attributes": { "title": "Sort by name (asc)" }, "components": [
        { "kind": "remochi.Button", "ontap": "cycleSort", "components": [
          { "kind": "pyxis.Icon", "icon": "ArrowUpDown", "size": 14, "style": "margin-right:4px;vertical-align:middle" },
          { "name": "sortLabel", "kind": "pyxis.Control", "tag": "span", "content": "NAME", "style": "font-size:0.78rem" }
        ] }
      ] },
      { "name": "newFolder", "kind": "remochi.Button", "variant": "blue", "ontap": "newFolder", "components": [
        { "kind": "pyxis.Icon", "icon": "FolderPlus", "size": 15, "style": "margin-right:6px;vertical-align:middle" },
        { "kind": "pyxis.Control", "tag": "span", "content": "New Folder" }
      ] }
    ] },
    { "kind": "pyxis.Control", "style": "padding:6px 14px;display:flex;justify-content:space-between;align-items:center;background:var(--mochi-hover, rgba(0,0,0,0.02));border-bottom:1px solid var(--color-border, var(--mochi-border, #e5e7eb));font-size:0.76rem;color:var(--color-text-secondary, #64748b)", "components": [
      { "name": "status", "kind": "pyxis.Control", "tag": "span" },
      { "kind": "pyxis.Control", "tag": "button", "classes": "files-refresh", "ontap": "reload", "attributes": { "title": "Refresh" }, "components": [
        { "kind": "pyxis.Icon", "icon": "RefreshCw", "size": 12 },
        { "kind": "pyxis.Control", "tag": "span", "content": "Refresh" }
      ] }
    ] },
    { "kind": "pyxis.Control", "style": "flex:1;min-height:0;overflow-y:auto;padding:10px", "components": [
      { "name": "loading", "kind": "pyxis.Control", "showing": false, "style": "display:flex;justify-content:center;align-items:center;height:100%", "components": [
        { "kind": "remochi.Spinner", "active": true, "size": "normal" }
      ] },
      { "name": "error", "kind": "pyxis.Control", "showing": false, "style": "display:flex;flex-direction:column;align-items:center;justify-content:center;height:80%;gap:12px;color:var(--color-error, #dc2626)", "components": [
        { "name": "errorText", "kind": "pyxis.Control", "tag": "span" },
        { "kind": "remochi.Button", "ontap": "reload", "components": [
          { "kind": "pyxis.Control", "tag": "span", "content": "Try Again" }
        ] }
      ] },
      { "name": "empty", "kind": "pyxis.Control", "showing": false, "style": "display:flex;flex-direction:column;align-items:center;justify-content:center;height:70%;gap:8px;color:var(--color-text-secondary, #64748b)", "components": [
        { "kind": "pyxis.Icon", "icon": "Folder", "size": 44, "style": "opacity:0.3" },
        { "name": "emptyTitle", "kind": "pyxis.Control", "tag": "span", "style": "font-size:0.9rem;font-weight:500" },
        { "name": "emptyHint", "kind": "pyxis.Control", "tag": "span", "style": "font-size:0.78rem;opacity:0.7" }
      ] },
      { "name": "listing", "kind": "Files.Listing", "showing": false, "onOpenEntry": "openEntry", "onEntryMenu": "entryMenu" }
    ] }
  ]
}
