{
  "name": "Files.App",
  "kind": "pyxis.Control",
  "style": "width:100%;height:100%;display:flex;flex-direction:column;box-sizing:border-box;background:var(--color-background, var(--mochi-bg, #f5f5f5));color:var(--color-text, var(--mochi-text, #111827));overflow:hidden;user-select:none",
  "published": { "windowId": "" },
  "events": { "onClose": "" },
  "components": [
    { "kind": "pyxis.Control", "style": "flex:1;min-height:0;position:relative", "components": [
      { "name": "stack", "kind": "remochi.RepanelStack", "activeIndex": 1, "peek": 260, "snapPoints": [1, 2, 3], "onActiveIndexChange": "panelMoved", "components": [
        { "kind": "remochi.Repanel", "components": [
          { "name": "sidebar", "kind": "Files.Sidebar", "onPickPlace": "pickPlace" }
        ] },
        { "kind": "remochi.Repanel", "components": [
          { "name": "browser", "kind": "Files.Browser",
            "onGoBack": "goBack", "onGoUp": "goUp", "onNavigate": "navigate", "onSearch": "search",
            "onViewMode": "pickViewMode", "onCycleSort": "cycleSort", "onNewFolder": "newFolder",
            "onReload": "reload", "onOpenEntry": "openEntry", "onEntryMenu": "entryMenu" }
        ] }
      ] }
    ] },
    { "name": "menu", "kind": "remochi.PopupPanel", "onClose": "menuClosed", "onAction": "menuAction", "components": [
      { "name": "menuPath", "kind": "pyxis.Control", "style": "font-size:0.78rem;color:var(--color-text-secondary);padding:2px 0" }
    ] },
    { "name": "dialogs", "kind": "Files.Dialogs", "onSubmit": "dialogSubmit", "onConfirmDelete": "dialogConfirmDelete", "onDismiss": "dialogDismiss", "onDismissError": "dismissError" }
  ]
}
