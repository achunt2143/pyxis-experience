{
  "name": "Files.App",
  "kind": "pyxis.Control",
  "style": "width:100%;height:100%;display:flex;flex-direction:column;box-sizing:border-box;background:var(--mochi-bg);color:var(--mochi-text);overflow:hidden;user-select:none",
  "published": { "windowId": "" },
  "events": { "onClose": "" },
  "components": [
    { "kind": "pyxis.Control", "style": "flex:1;min-height:0;position:relative", "components": [
      { "name": "stack", "kind": "remochi.RepanelStack", "keepPast": false, "activeIndex": 1, "peek": 260, "snapPoints": [1, 2, 3], "onActiveIndexChange": "panelMoved", "components": [
        { "kind": "remochi.Repanel", "components": [
          { "name": "sidebar", "kind": "Files.Sidebar", "onPickPlace": "pickPlace", "onClosePlaces": "closePlaces" }
        ] },
        { "kind": "remochi.Repanel", "components": [
          { "name": "browser", "kind": "Files.Browser",
            "onGoBack": "goBack", "onGoForward": "goForward", "onGoUp": "goUp", "onOpenPlaces": "openPlaces",
            "onNavigate": "navigate", "onSearch": "search", "onViewMode": "pickViewMode", "onCycleSort": "cycleSort",
            "onToggleHidden": "toggleHidden", "onNewFolder": "newFolder", "onReload": "reload",
            "onOpenEntry": "openEntry", "onEntryMenu": "entryMenu", "onRenameEntry": "renameEntry", "onDeleteEntry": "deleteEntry",
            "onRequestUnlock": "requestUnlock", "onRevokeUnlock": "revokeUnlock" }
        ] }
      ] }
    ] },
    { "name": "menu", "kind": "remochi.PopupPanel", "onDismiss": "menuClosed", "onAction": "menuAction", "components": [
      { "name": "menuPath", "kind": "pyxis.Control", "style": "font-size:0.78rem;color:var(--mochi-text-muted);padding:2px 0" }
    ] },
    { "name": "dialogs", "kind": "Files.Dialogs", "onSubmit": "dialogSubmit", "onConfirmDelete": "dialogConfirmDelete", "onDismiss": "dialogDismiss", "onDismissError": "dismissError" }
  ]
}
