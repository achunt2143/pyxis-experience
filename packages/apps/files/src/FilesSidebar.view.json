{
  "name": "Files.Sidebar",
  "kind": "pyxis.Control",
  "style": "position:absolute;inset:0;display:flex;flex-direction:column;min-width:0;min-height:0",
  "published": { "folder": "~", "storageInfo": null },
  "events": { "onPickPlace": "", "onClosePlaces": "" },
  "components": [
    { "kind": "remochi.Header", "content": "Files", "components": [
      { "kind": "pyxis.Control", "classes": "files-places-close", "components": [
        { "name": "closePlaces", "kind": "remochi.Button", "ontap": "closePlaces", "components": [
          { "kind": "pyxis.Icon", "icon": "ChevronRight", "size": 16 }
        ] }
      ] }
    ] },
    { "kind": "pyxis.Control", "style": "padding:0 32px", "components": [
      { "kind": "remochi.Divider" }
    ] },
    { "kind": "pyxis.Control", "style": "flex:1;overflow-y:auto;overflow-x:hidden;min-width:0;min-height:0;padding:4px 8px", "components": [
      { "kind": "remochi.List", "components": [
        { "kind": "remochi.ListHeader", "content": "FAVORITES" },
        { "name": "favorites", "kind": "pyxis.Repeater", "itemKind": "Files.Place", "keyField": "id", "itemProps": { "ontap": "pickPlace" }, "onSetupItem": "setupPlace" },
        { "kind": "pyxis.Control", "style": "margin:10px 4px 6px", "components": [ { "kind": "remochi.Divider" } ] },
        { "kind": "remochi.ListHeader", "content": "STORAGE" },
        { "name": "storage", "kind": "pyxis.Repeater", "itemKind": "Files.Place", "keyField": "id", "itemProps": { "ontap": "pickPlace" }, "onSetupItem": "setupPlace" }
      ] }
    ] },
    { "kind": "pyxis.Control", "style": "padding:12px 16px;border-top:1px solid var(--mochi-border);background:var(--mochi-surface)", "components": [
      { "kind": "pyxis.Control", "style": "display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:6px", "components": [
        { "kind": "pyxis.Control", "tag": "span", "content": "DEVICE STORAGE", "style": "font-size:0.75rem;font-weight:600;color:var(--mochi-text-muted)" },
        { "name": "storageStatus", "kind": "pyxis.Control", "tag": "span", "content": "Unavailable", "style": "font-size:0.75rem;color:var(--mochi-text-muted);font-weight:500" }
      ] },
      { "name": "storageBar", "kind": "remochi.ProgressBar", "value": 0, "color": "blue", "height": "6px", "showing": false },
      { "name": "storageDetail", "kind": "pyxis.Control", "tag": "span", "showing": false, "style": "display:block;margin-top:5px;font-size:0.71rem;color:var(--mochi-text-muted)" }
    ] }
  ]
}
