{
  "name": "Terminal.Tab",
  "kind": "pyxis.Row",
  "classes": "term-tab",
  "attributes": { "role": "tab", "tabIndex": 0 },
  "handlers": { "onkeydown": "tabKeyDown" },
  "published": { "active": false, "closable": false },
  "events": { "onCloseTab": "" },
  "components": [
    { "kind": "pyxis.Control", "tag": "span", "classes": "term-tab-dot" },
    { "name": "title", "kind": "pyxis.Control", "tag": "span" },
    { "name": "close", "kind": "pyxis.Control", "tag": "span", "classes": "term-tab-close", "showing": false,
      "attributes": { "role": "button", "tabIndex": 0, "title": "Close tab", "aria-label": "Close tab" },
      "ontap": "closeClicked", "onkeydown": "closeKeyDown", "components": [
      { "kind": "pyxis.Icon", "icon": "X", "size": 10 }
    ] }
  ]
}
