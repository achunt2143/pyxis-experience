{
  "name": "Terminal.App",
  "kind": "pyxis.Control",
  "classes": "term-app",
  "style": "width:100%;height:100%;background:var(--mochi-bg);color:var(--mochi-text);display:flex;flex-direction:column;min-height:0;min-width:0;overflow:hidden;position:relative",
  "published": { "windowId": "", "sessions": [], "activeId": "", "recent": [], "profile": null, "now": 0 },
  "events": { "onClose": "" },
  "components": [
    { "name": "stack", "kind": "remochi.RepanelStack", "activeIndex": 1, "peek": 320, "keepPast": true, "upcoming": "",
      "onUpcomingOpen": "peekOpened", "onActiveIndexChange": "panelMoved", "components": [

      { "name": "sessionsPanel", "kind": "remochi.Repanel", "components": [
        { "kind": "remochi.Header", "content": "Sessions" },
        { "name": "summary", "kind": "remochi.Subheader", "content": "" },
        { "kind": "pyxis.Control", "classes": "term-pane-body", "components": [
          { "name": "sessionList", "kind": "pyxis.Repeater", "itemKind": "Terminal.SessionRow", "keyField": "id",
            "itemProps": { "ontap": "pickSession" }, "onSetupItem": "setupRow", "classes": "term-rows" },
          { "name": "recentLabel", "kind": "remochi.Label", "content": "Start In" },
          { "name": "recentList", "kind": "pyxis.Repeater", "itemKind": "Terminal.FolderRow", "keyField": "cwd",
            "itemProps": { "ontap": "startIn" }, "classes": "term-rows" }
        ] },
        { "kind": "pyxis.Control", "classes": "term-pane-foot", "components": [
          { "name": "newButton", "kind": "remochi.Button", "content": "New Session", "ontap": "newSession" }
        ] }
      ] },

      { "name": "screenPanel", "kind": "remochi.Repanel", "components": [
        { "name": "screenHeader", "kind": "remochi.Header", "content": "Home" },
        { "name": "screenSub", "kind": "remochi.Subheader", "content": "" },
        { "name": "screens", "kind": "Terminal.Screens", "classes": "term-screens",
          "onCloseTab": "shellEnded", "onSetTitle": "titled", "onSetMode": "modeChanged", "onStatus": "statusChanged", "onBell": "bellRang",
          "onSelectionMenu": "selectionMenu" },
        { "kind": "pyxis.Control", "classes": "term-pane-foot", "components": [
          { "name": "keys", "kind": "pyxis.Repeater", "itemKind": "Terminal.Key", "keyField": "label", "onSend": "sendQuick",
            "classes": "term-keys", "attributes": { "role": "toolbar", "aria-label": "Keys" } },
          { "name": "sessionButton", "kind": "remochi.Button", "variant": "dropdown", "content": "Session", "ontap": "openSessionMenu" }
        ] }
      ] },

      { "name": "profilePanel", "kind": "remochi.Repanel", "showing": false, "components": [
        { "kind": "remochi.Header", "content": "Profile" },
        { "kind": "remochi.Subheader", "content": "Every session uses this profile" },
        { "kind": "pyxis.Control", "classes": "term-pane-body term-profile", "components": [
          { "kind": "remochi.Label", "content": "Text" },
          { "kind": "pyxis.Control", "classes": "term-field", "components": [
            { "kind": "pyxis.Control", "tag": "span", "classes": "term-field-name", "content": "Size" },
            { "name": "sizeSlider", "kind": "remochi.Slider", "min": 10, "max": 22, "step": 1, "width": "240px", "onChange": "sizePicked" },
            { "name": "sizeValue", "kind": "pyxis.Control", "tag": "span", "classes": "term-field-value" }
          ] },
          { "kind": "pyxis.Control", "classes": "term-field term-field-wrap", "attributes": { "role": "radiogroup", "aria-label": "Cursor" }, "components": [
            { "kind": "pyxis.Control", "tag": "span", "classes": "term-field-name", "content": "Cursor" },
            { "name": "cursorBlock", "kind": "remochi.Radio", "group": "term-cursor", "value": "block", "content": "Block", "onChange": "cursorPicked" },
            { "name": "cursorBar", "kind": "remochi.Radio", "group": "term-cursor", "value": "bar", "content": "Bar", "onChange": "cursorPicked" },
            { "name": "cursorUnderline", "kind": "remochi.Radio", "group": "term-cursor", "value": "underline", "content": "Underline", "onChange": "cursorPicked" }
          ] },
          { "kind": "pyxis.Control", "tag": "p", "classes": "term-note", "content": "The cursor fills when this window has focus and becomes an outline when it doesn't, like the window controls." },

          { "kind": "remochi.Label", "content": "Bell" },
          { "kind": "pyxis.Control", "classes": "term-field-column", "attributes": { "role": "radiogroup", "aria-label": "Bell" }, "components": [
            { "name": "bellLight", "kind": "remochi.Radio", "group": "term-bell", "value": "light", "content": "Light the pane edge", "onChange": "bellPicked" },
            { "name": "bellSound", "kind": "remochi.Radio", "group": "term-bell", "value": "sound", "content": "Play the Pyxis sound", "onChange": "bellPicked" },
            { "name": "bellNone", "kind": "remochi.Radio", "group": "term-bell", "value": "none", "content": "Nothing", "onChange": "bellPicked" }
          ] },
          { "kind": "pyxis.Control", "tag": "p", "classes": "term-note", "content": "A bell in another session puts a count on its row, whichever you choose." },

          { "kind": "remochi.Label", "content": "Sessions" },
          { "kind": "pyxis.Control", "classes": "term-field", "components": [
            { "kind": "pyxis.Control", "tag": "span", "classes": "term-field-name term-field-grow", "content": "Always show the keys" },
            { "name": "keysToggle", "kind": "remochi.Toggle", "onChange": "keysPicked" }
          ] },
          { "kind": "pyxis.Control", "classes": "term-field", "components": [
            { "kind": "pyxis.Control", "tag": "span", "classes": "term-field-name term-field-grow", "content": "Start in the last folder" },
            { "name": "lastFolderToggle", "kind": "remochi.Toggle", "onChange": "lastFolderPicked" }
          ] },
          { "kind": "pyxis.Control", "classes": "term-field", "components": [
            { "kind": "pyxis.Control", "tag": "span", "classes": "term-field-name term-field-grow", "content": "Ask before closing a busy session" },
            { "name": "askToggle", "kind": "remochi.Toggle", "onChange": "askPicked" }
          ] }
        ] }
      ] },

      { "name": "peek", "kind": "remochi.Repanel", "showing": false, "components": [
        { "name": "peekHeader", "kind": "remochi.Header", "content": "" }
      ] }
    ] },

    { "name": "sessionMenu", "kind": "remochi.PopupPanel", "anchor": "sessionButton", "onAction": "sessionMenuAction",
      "actions": [
        { "label": "Copy", "action": "copy" },
        { "label": "Paste", "action": "paste" },
        { "label": "Clear", "action": "clear" },
        { "label": "Profile", "action": "profile" },
        { "label": "Close Session", "action": "close", "type": "warning" }
      ] },
    { "name": "selectionMenu", "kind": "remochi.PopupPanel", "onAction": "sessionMenuAction",
      "actions": [
        { "label": "Copy", "action": "copy" },
        { "label": "Paste", "action": "paste" }
      ] },
    { "name": "closeDialog", "kind": "remochi.Dialog", "dialogType": "confirm", "confirmType": "warning", "tone": "warning",
      "confirmText": "Close Session", "cancelText": "Cancel", "onConfirm": "closeConfirmed", "onCancel": "closeCancelled", "onDismiss": "closeCancelled", "components": [
      { "name": "closeText", "kind": "pyxis.Control", "tag": "p", "classes": "term-dialog-text" }
    ] }
  ]
}
